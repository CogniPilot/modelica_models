setCommandLineOptions("--std=3.6");

if not loadModel(Vehicles) then
  print(getErrorString());
  exit(1);
end if;

buildDirectory := getTempDirectoryPath();
cd(buildDirectory);

controllerTranslation := translateModel(Vehicles.Rdd2.Controller);
controllerMessages := getErrorString();
if not controllerTranslation then
  print(controllerMessages);
  exit(1);
end if;
print(controllerMessages);

estimatorTranslation := translateModel(Vehicles.Rdd2.NavigationEstimator);
estimatorMessages := getErrorString();
if not estimatorTranslation then
  print(estimatorMessages);
  exit(1);
end if;
print(estimatorMessages);

reducedControllerTranslation :=
  translateModel(Vehicles.Rdd2.ReducedRateController);
reducedControllerMessages := getErrorString();
if not reducedControllerTranslation then
  print(reducedControllerMessages);
  exit(1);
end if;
print(reducedControllerMessages);

manualGuidanceTranslation :=
  translateModel(Vehicles.Rdd2.ManualTrajectorySource);
manualGuidanceMessages := getErrorString();
if not manualGuidanceTranslation then
  print(manualGuidanceMessages);
  exit(1);
end if;
print(manualGuidanceMessages);

modeSelectorTranslation := translateModel(Vehicles.Rdd2.FlightModeSelector);
modeSelectorMessages := getErrorString();
if not modeSelectorTranslation then
  print(modeSelectorMessages);
  exit(1);
end if;
print(modeSelectorMessages);

plantTranslation := translateModel(Vehicles.Rdd2.Plant);
plantMessages := getErrorString();
if not plantTranslation then
  print(plantMessages);
  exit(1);
end if;
print(plantMessages);

plannerTranslation := translateModel(Planning.Bezier.WaypointTrajectoryPlanner);
plannerMessages := getErrorString();
if not plannerTranslation then
  print(plannerMessages);
  exit(1);
end if;
print(plannerMessages);

// OpenModelica 1.27's legacy C backend cannot lower the sampled assignment
// of the multi-array closed-form IMU preintegral.  Keep semantic boundary
// validation here; the Rumoca CI mission jobs compile and simulate these
// complete closed-loop models.
clearMessages();
waypointMissionCheck :=
  checkModel(Vehicles.Rdd2.Test.WaypointMission);
waypointMissionMessages := getErrorString();
(_, waypointMissionErrors, _) := countMessages();
if waypointMissionErrors > 0 then
  print(waypointMissionMessages);
  exit(1);
end if;
print(waypointMissionCheck);
print(waypointMissionMessages);

clearMessages();
globalWaypointMissionCheck :=
  checkModel(Vehicles.Rdd2.Test.GlobalWaypointMission);
globalWaypointMissionMessages := getErrorString();
(_, globalWaypointMissionErrors, _) := countMessages();
if globalWaypointMissionErrors > 0 then
  print(globalWaypointMissionMessages);
  exit(1);
end if;
print(globalWaypointMissionCheck);
print(globalWaypointMissionMessages);

clearMessages();
reducedControllerMissionCheck :=
  checkModel(Vehicles.Rdd2.Test.ReducedControllerWaypointMission);
reducedControllerMissionMessages := getErrorString();
(_, reducedControllerMissionErrors, _) := countMessages();
if reducedControllerMissionErrors > 0 then
  print(reducedControllerMissionMessages);
  exit(1);
end if;
print(reducedControllerMissionCheck);
print(reducedControllerMissionMessages);

clearMessages();
opticalFlowGpsDeniedMissionCheck :=
  checkModel(Vehicles.Rdd2.Test.OpticalFlowGpsDeniedMission);
opticalFlowGpsDeniedMissionMessages := getErrorString();
(_, opticalFlowGpsDeniedMissionErrors, _) := countMessages();
if opticalFlowGpsDeniedMissionErrors > 0 then
  print(opticalFlowGpsDeniedMissionMessages);
  exit(1);
end if;
print(opticalFlowGpsDeniedMissionCheck);
print(opticalFlowGpsDeniedMissionMessages);

clearMessages();
manualFlightMissionCheck :=
  checkModel(Vehicles.Rdd2.Test.ManualFlightMission);
manualFlightMissionMessages := getErrorString();
(_, manualFlightMissionErrors, _) := countMessages();
if manualFlightMissionErrors > 0 then
  print(manualFlightMissionMessages);
  exit(1);
end if;
print(manualFlightMissionCheck);
print(manualFlightMissionMessages);

clearMessages();
vibrationMissionCheck :=
  checkModel(Vehicles.Rdd2.Test.VibrationGlobalWaypointMission);
vibrationMissionMessages := getErrorString();
(_, vibrationMissionErrors, _) := countMessages();
if vibrationMissionErrors > 0 then
  print(vibrationMissionMessages);
  exit(1);
end if;
print(vibrationMissionCheck);
print(vibrationMissionMessages);

cubs2ControlTranslation := translateModel(Vehicles.Cubs2.AvionicsSystem);
cubs2ControlMessages := getErrorString();
if not cubs2ControlTranslation then
  print(cubs2ControlMessages);
  exit(1);
end if;
print(cubs2ControlMessages);

cubs2VehicleTranslation := translateModel(Vehicles.Cubs2.ClosedLoopVehicle);
cubs2VehicleMessages := getErrorString();
if not cubs2VehicleTranslation then
  print(cubs2VehicleMessages);
  exit(1);
end if;
print(cubs2VehicleMessages);

cubs2MissionTranslation := translateModel(Vehicles.Cubs2.Test.Scenarios.Mission);
cubs2MissionMessages := getErrorString();
if not cubs2MissionTranslation then
  print(cubs2MissionMessages);
  exit(1);
end if;
print(cubs2MissionMessages);

exit(0);
