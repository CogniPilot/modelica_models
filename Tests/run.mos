setCommandLineOptions("--std=3.6");

if not loadModel(Modelica, {"4.1.0"}) then
  print(getErrorString());
  exit(1);
end if;
mslVersion := getVersion(Modelica);
if mslVersion <> "4.1.0" then
  print("Expected MSL 4.1.0, got " + mslVersion + "\n");
  exit(1);
end if;
print("MSL_VERSION=" + mslVersion + "\n");

if not loadModel(Tests) then
  print(getErrorString());
  exit(1);
end if;

testOutputDirectory := getTempDirectoryPath();
cd(testOutputDirectory);

smoke := simulate(
  Tests.MslRotationalSmoke,
  startTime=0.0,
  stopTime=0.1,
  numberOfIntervals=10,
  tolerance=1.0e-8,
  method="dassl",
  outputFormat="csv",
  fileNamePrefix="modelica_models_MslRotationalSmoke"); getErrorString();
smokeResultFile := smoke.resultFile;
if smokeResultFile == "" then
  print("MSL Rotational smoke failed\n");
  exit(1);
end if;
print("MSL_ROTATIONAL_SMOKE_OK\n");

// The Microduck assembly is checked at its start pose only: the rest-tree start
// height must put the lowest sole sphere 1 mm above the ground.
microduck := simulate(
  Tests.MicroduckTests.InitialPose,
  startTime=0.0,
  stopTime=0.0,
  tolerance=1.0e-8,
  method="dassl",
  outputFormat="csv",
  fileNamePrefix="modelica_models_MicroduckInitialPose"); getErrorString();
microduckResultFile := microduck.resultFile;
if microduckResultFile == "" then
  print("Microduck start pose check failed\n");
  exit(1);
end if;
print("MICRODUCK_INITIAL_POSE_OK\n");

check := checkModel(Tests.All);
print(check);
print(getErrorString());

res := simulate(
  Tests.All,
  startTime=0.0,
  stopTime=1.0,
  numberOfIntervals=1000,
  tolerance=1.0e-8,
  method="dassl",
  outputFormat="mat",
  fileNamePrefix="modelica_models_Tests_All"); getErrorString();
resultFile := res.resultFile;
if resultFile <> "" then
  exit(0);
end if;
print("Modelica test simulation failed\n");
exit(1);
